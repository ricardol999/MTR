# Copia este archivo a .env y ajusta la IP a la de tu máquina en la LAN.
# Las variables EXPO_PUBLIC_* se inyectan en la app Expo en tiempo de build.

# URL de la API del motor (engine/api). Con Expo Go en el teléfono debe ser la
# IP LAN de tu computadora (no localhost), p. ej. http://192.168.1.50:8000
EXPO_PUBLIC_ENGINE_API_URL=http://192.168.1.50:8000

# URL del servicio de sincronización de escaneos (syncService).
EXPO_PUBLIC_SYNC_API_URL=http://192.168.1.50:3000/api/scans
